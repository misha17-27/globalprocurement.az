<FilesMatch "\.(php|php3|php4|php5|php7|php8|phtml|phar|pl|py|cgi|sh)$">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    <FilesMatch "\.svg$">
        Header always set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
    </FilesMatch>
</IfModule>
Options -Indexes
